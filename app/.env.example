# ── Variables de la app (llegan al navegador) ────────────────────────────
# Las del proyecto de Supabase. La clave «anon» es pública por diseño: lo que
# protege los datos es la RLS, no el secreto de esta cadena.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Opcional. De dónde leer los precios mientras la tabla `prices` esté vacía.
# Por defecto, los JSON que sigue publicando el repositorio antiguo.
# VITE_FEED_URL=https://raw.githubusercontent.com/MarcAiBTC/Cartera/main

# ── Variables del servidor (NO llegan al navegador) ──────────────────────
# Sin el prefijo VITE_ a propósito: eso es lo que impide que acaben en el
# paquete que se descarga el navegador.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Salta la RLS. Si se filtra, cualquiera puede leer y escribir TODAS las
# carteras. Sólo en las variables de entorno de Vercel, nunca en el repo.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Lo que impide que un desconocido dispare los crons en bucle y nos bloqueen
# la IP en Yahoo. Vercel lo manda como «Authorization: Bearer …».
CRON_SECRET=una-cadena-larga-y-aleatoria

# Para crear las tablas desde `npm run preparar`. Supabase la da en
# Project Settings -> Database -> Connection string -> URI (Session pooler),
# con [YOUR-PASSWORD] sustituido por la contrasena de la base de datos.
DATABASE_URL=postgresql://postgres.xxxx:CONTRASENA@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
